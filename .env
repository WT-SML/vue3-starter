# 环境变量
VITE_APP_TITLE = Maple # 网页基础 title
VITE_APP_AUTHOR = Maple # 作者
VITE_APP_VERSION_CODE_PUBLISH = v1 # 发布版本号
VITE_APP_VERSION_CODE_FULL = v1.0.0 # 完整版本号
VITE_APP_API_BASE_URL = /api # 后端接口 BASE_URL
VITE_APP_REQ_TIMEOUT = 30 # 后端接口 超时时间 30s
VITE_APP_REQ_LOCALE_KEY = Lang # 后端接口 语言的 key
VITE_APP_AUTH_USER_KEY = authUser # 登录用户信息存储的 key
VITE_APP_MOCK_OPEN = true # mock 开关
